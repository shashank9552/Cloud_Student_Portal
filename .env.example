# AWS Region where Cognito, DynamoDB, Lambda, and S3 are provisioned
VITE_AWS_REGION=ap-south-1

# Amazon Cognito User Pool ID (from Phase 2, e.g. ap-south-1_xxxxxxxxx)
VITE_COGNITO_USER_POOL_ID=your_user_pool_id

# Amazon Cognito Browser App Client ID (without client secret)
VITE_COGNITO_CLIENT_ID=your_app_client_id

# Phase 4 Amazon API Gateway HTTP API Endpoint URL (Output from CloudFormation api-backend.yaml)
# e.g. https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com
VITE_API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com

# Amazon S3 Submissions Bucket Name (Output from CloudFormation api-backend.yaml)
VITE_S3_BUCKET_NAME=cloudedu-submissions-123456789012-ap-south-1

# Mock Switch: Set to 'false' to connect frontend directly to real AWS API Gateway and S3.
# When 'true' (or if API Gateway is unavailable), application gracefully uses local mock fallback.
VITE_USE_AWS_MOCK=false

