# Environment Configuration Template
# For local evaluation and portfolio demos, keep MOCK enabled (default)
VITE_USE_AWS_MOCK=true

# AWS Regional Deployment (Phase 2)
VITE_AWS_REGION=us-east-1

# Amazon Cognito Authentication & User Pools
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_IDENTITY_POOL_ID=

# Amazon API Gateway (REST API endpoint)
VITE_API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Amazon S3 Storage Bucket (Student Submissions)
VITE_S3_BUCKET_NAME=student-portal-assignments-storage
